# Copy this file to backend/.env and paste ONE of the two TMDB credentials.
# Get them for free at https://www.themoviedb.org/settings/api (TMDB account required).
# This file is read only by the Python backend - the key never reaches the browser.

# v4 "API Read Access Token" (long string starting with eyJ...) - preferred
TMDB_ACCESS_TOKEN=

# or the v3 "API Key" (32 characters)
TMDB_API_KEY=
